# API Configuration
# Backend server URL (Express.js API server)
VITE_API_URL=http://localhost:5000

# Supabase Configuration (optional - only needed for file storage)
# Leave empty to use the Express backend for authentication
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin email (optional - designates the primary admin account)
VITE_ADMIN_EMAIL=